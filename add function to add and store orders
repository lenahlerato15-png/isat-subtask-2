#include <iostream>
using namespace std;

// Conversion functions
double celsiusToFahrenheit(double celsius)
{
    return (celsius * 9.0 / 5.0) + 32;
}

double fahrenheitToCelsius(double fahrenheit)
{
    return (fahrenheit - 32) * 5.0 / 9.0;
}

double kilometresToMiles(double kilometres)
{
    return kilometres * 0.621371;
}

double milesToKilometres(double miles)
{
    return miles * 1.60934;
}

// Display menu
void displayMenu()
{
    cout << "\n===== UNIT CONVERTER =====" << endl;
    cout << "1. Celsius to Fahrenheit" << endl;
    cout << "2. Fahrenheit to Celsius" << endl;
    cout << "3. Kilometres to Miles" << endl;
    cout << "4. Miles to Kilometres" << endl;
    cout << "5. Exit" << endl;
    cout << "==========================" << endl;
}

int main()
{
    int choice;
    double value;

    do
    {
        displayMenu();

        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                cout << "Enter temperature in Celsius: ";
                cin >> value;
                cout << "Result: " << celsiusToFahrenheit(value)
                     << " Fahrenheit" << endl;
                break;

            case 2:
                cout << "Enter temperature in Fahrenheit: ";
                cin >> value;
                cout << "Result: " << fahrenheitToCelsius(value)
                     << " Celsius" << endl;
                break;

            case 3:
                cout << "Enter distance in kilometres: ";
                cin >> value;
                cout << "Result: " << kilometresToMiles(value)
                     << " miles" << endl;
                break;

            case 4:
                cout << "Enter distance in miles: ";
                cin >> value;
                cout << "Result: " << milesToKilometres(value)
                     << " kilometres" << endl;
                break;

            case 5:
                cout << "Thank you for using the Unit Converter!" << endl;
                break;

            default:
                cout << "Invalid choice. Please try again." << endl;
        }

    } while (choice != 5);

    return 0;
}
